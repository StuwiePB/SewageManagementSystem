APP_NAME=BruDMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Amazon SNS (operational alerts — email/SMS/SQS subscribers on your topic)
AWS_SNS_ENABLED=false
AWS_SNS_TOPIC_ARN=
# Optional override; defaults to AWS_DEFAULT_REGION
# AWS_SNS_REGION=us-east-1
# Queue SNS publishes (recommended; uses QUEUE_CONNECTION)
AWS_SNS_QUEUE=true
# Incident AI risk score threshold for automatic alerts (0–100)
AWS_SNS_MIN_INCIDENT_RISK_SCORE=70
# Work order priorities that trigger SNS (comma-separated)
AWS_SNS_WORK_ORDER_PRIORITIES=high,critical
# Validate SNS signature on POST /webhooks/sns (keep true in production)
AWS_SNS_WEBHOOK_VALIDATE_SIGNATURE=true
# Production HTTPS subscription (AWS SNS → your app), e.g. https://brudms.me/webhooks/sns
# APP_URL must match your public domain (no trailing slash).

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=bruflow-local
REVERB_APP_KEY=bruflow-reverb-key
REVERB_APP_SECRET=bruflow-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# OpenAI (BruFlowGPT) — use a real key only in .env, never commit it
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Cloud Vision (optional) — path to service account JSON on your machine
GOOGLE_APPLICATION_CREDENTIALS=

# Twilio SMS (phone OTP). TWILIO_FROM = E.164 sender number or Messaging Service SID (MG…).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional: minutes the browser session counts as “verified” after a successful code (default 30).
TWILIO_OTP_SESSION_MINUTES=30
# Local/tests only: fixed 6-digit code, skips real SMS (never set in production).
# For real Telesign/Twilio SMS, leave BOTH empty — otherwise no text is sent.
TWILIO_FAKE_OTP=
SMS_FAKE_OTP=

# SMS transport: twilio | telesign | http | log
SMS_DRIVER=twilio

# Telesign SMS Verify (when SMS_DRIVER=telesign). Customer ID + API key from Telesign dashboard.
TELESIGN_CUSTOMER_ID=
TELESIGN_API_KEY=
# Optional: https://rest-ww.telesign.com (default). Use case: BACS, BACF, ATCK, etc.
TELESIGN_HOST=https://rest-ww.telesign.com
TELESIGN_UCID=BACS

# Generic HTTP SMS provider (used when SMS_DRIVER=http)
SMS_HTTP_URL=
SMS_HTTP_API_KEY=
SMS_HTTP_SENDER=
SMS_HTTP_METHOD=POST
